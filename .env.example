# ====================================================================
# AgentBench Configuration
# Copy this file to .env and adjust variables as needed.
# ====================================================================

# Local-First LLM Provider (Free default via Ollama)
MODEL_PROVIDER=ollama
MODEL_NAME=qwen2.5-coder:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Optional Cloud Model Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CUSTOM_API_BASE=
CUSTOM_API_KEY=

# Persistence
DATABASE_URL=sqlite:///./agentbench.db

# Sandboxing Runtime: 'local' (Process Isolation) or 'docker' (Container Mount)
SANDBOX_RUNTIME=local
DOCKER_IMAGE=python:3.11-slim
EXECUTION_TIMEOUT=120

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
